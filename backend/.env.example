NODE_ENV=development
PORT=3000
MONGO_URL=mongodb://localhost:27017/lend?directConnection=true
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10
LOG_LEVEL=info
HOLD_SECONDS=900

# Payments: "fake" (no network, use POST /v1/dev/payments/:orderId/authorize) or "stripe" (test mode)
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sign in with Apple (your app's bundle id)
APPLE_BUNDLE_ID=

# APNs (token auth). Leave empty to log pushes instead of sending them.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
